# ============================== OMENT BACKEND ==============================
# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# ── MongoDB ────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=oment
# auto = use MongoDB transactions when the server supports them (Atlas / replica set)
MONGO_TRANSACTIONS=auto
# First start on an EMPTY database: true = demo company, false = blank company
SEED_DEMO_DATA=true

# ── Login ──────────────────────────────────────────────────────────────────
# Long random string (32+ characters). Changing it logs everyone out.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Where admin emails go (falls back to Settings → Billing email)
ADMIN_EMAIL=
RESET_TOKEN_MINUTES=30

# ── Frontend ───────────────────────────────────────────────────────────────
# Frontend addresses allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
# Frontend base URL — used for links in emails (…/admin/ and …/employee/)
APP_URL=http://localhost:5500
JSON_LIMIT=10mb

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Fill these and restart — nothing else to change. Empty = emails are only
# printed in the server console.
#
# Gmail (easiest): turn on 2-step verification, create an App password at
#   https://myaccount.google.com/apppasswords  and use it as SMTP_PASS
#   SMTP_SERVICE=gmail
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=abcd efgh ijkl mnop
#   SMTP_FROM="Your Company <you@gmail.com>"
#
# Outlook / Office 365:  SMTP_SERVICE=outlook365
# Zoho:                  SMTP_HOST=smtp.zoho.in  SMTP_PORT=465  SMTP_SECURE=true
# Any other provider:    SMTP_HOST / SMTP_PORT / SMTP_SECURE from your provider
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Oment <no-reply@example.com>"
EMAIL_ENABLED=true
MAILER_INTERVAL_MS=15000
MAIL_MAX_ATTEMPTS=5

# ── Reminders ──────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true

# ── Integrations (optional) ────────────────────────────────────────────────
# CRM sends this in the X-Webhook-Secret header to POST /api/integrations/crm/deal-won
CRM_WEBHOOK_SECRET=
# Een AI answers (Google Gemini). Leave empty to use data-built answers only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
